{
  "diffMode": "github",
  "enableCompletionBell": false,
  "completionSound": "fx-ok01",
  "awaitingInputSound": "fx-ack01",
  "soundFocusMode": "always",
  "commandAllowlist": [
    "ls",
    "pwd",
    "dir"
  ],
  "commandDenylist": [
    "rm -rf /",
    "rm -rf /*",
    "rm -rf .",
    "rm -rf ~",
    "rm -rf ~/*",
    "rm -rf $HOME",
    "rm -r /",
    "rm -r /*",
    "rm -r ~",
    "rm -r ~/*",
    "mkfs",
    "mkfs.ext4",
    "mkfs.ext3",
    "mkfs.vfat",
    "mkfs.ntfs",
    "dd if=/dev/zero of=/dev",
    "dd of=/dev",
    "shutdown",
    "reboot",
    "halt",
    "poweroff",
    "init 0",
    "init 6",
    ":(){ :|: & };:",
    ":() { :|:& };:",
    "chmod -R 777 /",
    "chmod -R 000 /",
    "chown -R",
    "Format-Volume",
    "format.com",
    "powershell Remove-Item -Recurse -Force"
  ],
  "enableCustomDroids": true,
  "includeCoAuthoredByDroid": false,
  "enableDroidShield": true,
  "enableReadinessReport": true,
  "todoDisplayMode": "pinned",
  "allowBackgroundProcesses": false,
  "showThinkingInMainView": false,
  "ideAutoConnect": false,
  "sessionDefaultSettings": {
    "model": "claude-opus-4-6",
    "reasoningEffort": "high",
    "autonomyMode": "auto-high",
    "specModeReasoningEffort": "low"
  },
  "logoAnimation": "off"
}
